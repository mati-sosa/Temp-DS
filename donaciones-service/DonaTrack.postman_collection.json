    {
      "name": "Donaciones",
      "item": [
        {
          "name": "Registrar donación (no perecederos)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/donaciones", "host": ["{{base_url}}"], "path": ["donaciones"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion\": \"Donación por mudanza de oficina\",\n  \"donanteId\": {{donante_id}},\n  \"bienes\": [\n    {\n      \"descripcion\": \"Mesa rectangular de madera\",\n      \"subcategoriaDescripcion\": \"Mesa\",\n      \"categoriaDescripcion\": \"Mobiliario\",\n      \"unidadMedida\": \"UNIDADES\",\n      \"cantidad\": 1.0,\n      \"perecedero\": false,\n      \"tieneEstado\": true,\n      \"esNuevo\": false\n    },\n    {\n      \"descripcion\": \"Sillas de madera\",\n      \"subcategoriaDescripcion\": \"Silla\",\n      \"categoriaDescripcion\": \"Mobiliario\",\n      \"unidadMedida\": \"UNIDADES\",\n      \"cantidad\": 6.0,\n      \"perecedero\": false,\n      \"tieneEstado\": true,\n      \"esNuevo\": false\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Registrar donación (perecederos)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/donaciones", "host": ["{{base_url}}"], "path": ["donaciones"] },
            "body": {
