              "raw": "{\n  \"descripcion\": \"Donación de alimentos\",\n  \"donanteId\": {{donante_id}},\n  \"bienes\": [\n    {\n      \"descripcion\": \"Bolsas de arroz 1kg\",\n      \"subcategoriaDescripcion\": \"Arroz\",\n      \"categoriaDescripcion\": \"Alimentos\",\n      \"unidadMedida\": \"KILOGRAMOS\",\n      \"cantidad\": 50.0,\n      \"perecedero\": true,\n      \"fechaVencimiento\": \"2027-01-01\"\n    },\n    {\n      \"descripcion\": \"Cajas de fideos 500g\",\n      \"subcategoriaDescripcion\": \"Fideos\",\n      \"categoriaDescripcion\": \"Alimentos\",\n      \"unidadMedida\": \"KILOGRAMOS\",\n      \"cantidad\": 25.0,\n      \"perecedero\": true,\n      \"fechaVencimiento\": \"2027-06-01\"\n    }\n  ]\n}"
