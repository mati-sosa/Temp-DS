    {
      "name": "Estados y Auditoría",
      "item": [
        {
          "name": "1. ASIGNAR (En depósito → Asignación realizada)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/donaciones/{{donacion_id}}/estado", "host": ["{{base_url}}"], "path": ["donaciones", "{{donacion_id}}", "estado"] },
            "body": { "mode": "raw", "raw": "{\n  \"accion\": \"ASIGNAR\"\n}" }
          }
        },
        {
          "name": "2. PLANIFICAR_RUTA (Asignación realizada → Lista para entregar)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/donaciones/{{donacion_id}}/estado", "host": ["{{base_url}}"], "path": ["donaciones", "{{donacion_id}}", "estado"] },
            "body": { "mode": "raw", "raw": "{\n  \"accion\": \"PLANIFICAR_RUTA\"\n}" }
          }
        },
        {
          "name": "3. DESPACHAR (Lista para entregar → En traslado)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/donaciones/{{donacion_id}}/estado", "host": ["{{base_url}}"], "path": ["donaciones", "{{donacion_id}}", "estado"] },
            "body": { "mode": "raw", "raw": "{\n  \"accion\": \"DESPACHAR\"\n}" }
          }
        },
        {
          "name": "4a. ENTREGAR (En traslado → Entregada)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/donaciones/{{donacion_id}}/estado", "host": ["{{base_url}}"], "path": ["donaciones", "{{donacion_id}}", "estado"] },
            "body": { "mode": "raw", "raw": "{\n  \"accion\": \"ENTREGAR\"\n}" }
          }
        },
        {
          "name": "4b. FALLAR (En traslado → Entrega fallida)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/donaciones/{{donacion_id}}/estado", "host": ["{{base_url}}"], "path": ["donaciones", "{{donacion_id}}", "estado"] },
            "body": { "mode": "raw", "raw": "{\n  \"accion\": \"FALLAR\",\n  \"justificacion\": \"Nadie abrió la puerta al tocar timbre\"\n}" }
          }
        },
        {
          "name": "5. ALMACENAR (Entrega fallida → En depósito)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/donaciones/{{donacion_id}}/estado", "host": ["{{base_url}}"], "path": ["donaciones", "{{donacion_id}}", "estado"] },
            "body": { "mode": "raw", "raw": "{\n  \"accion\": \"ALMACENAR\"\n}" }
          }
        },
        {
          "name": "VENCER (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/donaciones/{{donacion_id}}/estado", "host": ["{{base_url}}"], "path": ["donaciones", "{{donacion_id}}", "estado"] },
            "body": { "mode": "raw", "raw": "{\n  \"accion\": \"VENCER\"\n}" }
          }
        },
        {
          "name": "Ver historial de auditoría",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/donaciones/{{donacion_id}}/auditoria", "host": ["{{base_url}}"], "path": ["donaciones", "{{donacion_id}}", "auditoria"] }
          }
        },
        {
          "name": "[ERROR 409] Transición inválida",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/donaciones/{{donacion_id}}/estado", "host": ["{{base_url}}"], "path": ["donaciones", "{{donacion_id}}", "estado"] },
            "body": { "mode": "raw", "raw": "{\n  \"accion\": \"ENTREGAR\"\n}" }
          }
        },
        {
          "name": "[ERROR 400] Acción inexistente",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/donaciones/{{donacion_id}}/estado", "host": ["{{base_url}}"], "path": ["donaciones", "{{donacion_id}}", "estado"] },
            "body": { "mode": "raw", "raw": "{\n  \"accion\": \"VOLAR\"\n}" }
          }
        }
      ]
    }
  ]
