          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Ruta creada con estado Planificada\", function () {",
                  "    pm.expect(jsonData.estado).to.eql(\"Planificada\");",
                  "});",
                  "pm.test(\"Tiene 1 destino con 2 entregas en estado Pendiente\", function () {",
                  "    pm.expect(jsonData.destinos).to.have.lengthOf(1);",
                  "    pm.expect(jsonData.destinos[0].entregas).to.have.lengthOf(2);",
                  "    pm.expect(jsonData.destinos[0].entregas[0].estado).to.eql(\"Pendiente\");",
                  "});",
                  "pm.collectionVariables.set(\"ruta_id\", jsonData.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/rutas", "host": ["{{base_url}}"], "path": ["rutas"] },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"chofer\": { \"id\": \"CH-1\", \"nombre\": \"Juan Perez\" },\n  \"camion\": { \"patente\": \"AB123CD\", \"altura\": 2.5, \"capacidadVolumen\": 20, \"capacidadCarga\": 1500, \"disponible\": true },\n  \"fechaReparto\": \"2026-07-10T09:00:00\",\n  \"destinos\": [\n    {\n      \"direccion\": { \"calle\": \"Calle Falsa 123\", \"ciudad\": \"CABA\", \"provincia\": \"Buenos Aires\", \"codigoPostal\": \"1000\" },\n      \"entidadBeneficiariaID\": \"entidad-1\",\n      \"orden\": 1,\n      \"entregas\": [\n        { \"donacionID\": \"donacion-1\" },\n        { \"donacionID\": \"donacion-2\" }\n      ]\n    }\n  ]\n}"
            }
          }
        },
